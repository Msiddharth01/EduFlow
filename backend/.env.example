PORT=5001
NODE_ENV=development

# PostgreSQL connection string with pgvector
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/learning_assistant?schema=public"

# JWT Authentication Secret
JWT_SECRET="capstone_super_secret_jwt_key_2026_change_in_production"
JWT_EXPIRES_IN="7d"

# Local AI / Ollama Endpoint
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_CHAT_MODEL="llama3.2:3b"
OLLAMA_EMBED_MODEL="nomic-embed-text"

# File Upload Directory (Local Fallback)
UPLOAD_DIR="./uploads"

# Supabase Storage Configuration (Private PDF Bucket)
# Project: supabase-amber-lamp
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_STORAGE_BUCKET="eduflow-pdfs"

# Supabase PostgreSQL Connection URI (From Project Settings -> Database -> Connection String)
# Transaction pooler (Port 6543) or Session pooler / Direct (Port 5432)
SUPABASE_DATABASE_URL="postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"


